{
  "name": "scaffolddataclouder-node",
  "version": "0.0.32",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "update:dc": "git submodule update --remote --merge libs/nest-dataclouder",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@dataclouder/notion": "^0.0.4",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.5",
    "@google-cloud/storage": "7.22.0",
    "@google-cloud/text-to-speech": "^5.8.0",
    "@google/genai": "^1.19.0",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@types/node-notifier": "^8.0.5",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "date-fns": "4.4.0",
    "dotenv": "16.6.1",
    "es-toolkit": "1.52.0",
    "fastify": "5.12.5",
    "firebase-admin": "^13.0.2",
    "google-auth-library": "11.1.0",
    "minio": "8.0.7",
    "mongodb": "7.8.0",
    "mongoose": "9.12.0",
    "nanoid": "6.0.1",
    "node-notifier": "^10.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "stripe": "15.12.0",
    "tsconfig-paths": "4.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.16.13",
    "@types/jest": "30.0.0",
    "@types/multer": "1.4.13",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.14",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.2",
    "webpack": "5.106.2",
    "webpack-node-externals": "3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/src/common/node-slowbuffer.shim.ts"
    ],
    "roots": [
      "<rootDir>/src/"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^@dataclouder/nest-core(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-core/src/$1",
      "^@dataclouder/nest-auth(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-auth/src/$1",
      "^@dataclouder/nest-mongo(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-mongo/src/$1",
      "^@dataclouder/nest-storage(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-storage/src/$1",
      "^@dataclouder/nest-users(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-users/src/$1",
      "^@dataclouder/nest-agent-cards(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-agent-cards/src/$1",
      "^@dataclouder/nest-agentic-chat(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-agentic-chat/src/$1",
      "^@dataclouder/nest-conversations(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-conversations/src/$1",
      "^@dataclouder/nest-roleplay(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-roleplay/src/$1",
      "^@dataclouder/nest-theatre(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-theatre/src/$1",
      "^@dataclouder/nest-knowledge(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-knowledge/src/$1",
      "^@dataclouder/nest-lessons(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-lessons/src/$1",
      "^@dataclouder/nest-ai-services-sdk(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-ai-services-sdk/src/$1",
      "^@dataclouder/nest-ai-services-mongodb(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-ai-services-mongodb/src/$1",
      "^@dataclouder/nest-payments(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-payments/src/$1",
      "^@dataclouder/nest-analytics(|/.*)$": "<rootDir>/libs/nest-dataclouder/nest-analytics/src/$1"
    }
  }
}
